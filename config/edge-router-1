!
hostname edge_router_1
!
boot-start-marker
boot-end-marker
!
!
!
no aaa new-model
!
!
!
mmi polling-interval 60
no mmi auto-configure
no mmi pvc
mmi snmp-timeout 180
!
!
!
!
!
!
!
!
!
!
!
ip cef
no ipv6 cef
!
multilink bundle-name authenticated
!
!
!
!
!
redundancy
!
!
!
!
!
!
!
!
!
!
!
!
!
!
!
interface Loopback1
 ip address 203.0.113.1 255.255.255.255
!
interface GigabitEthernet0/0
 description *Link to Switch > firewall & Edge_Router 2*
 ip address 192.0.2.1 255.255.255.248
 ip ospf bfd
 ip ospf cost 20
 duplex auto
 speed auto
 media-type rj45
 bfd interval 300 min_rx 300 multiplier 3
!
interface GigabitEthernet0/1
 ip address 200.0.113.253 255.255.255.252
 duplex auto
 speed auto
 media-type rj45
 bfd interval 300 min_rx 300 multiplier 3
!
interface GigabitEthernet0/2
 ip address 10.10.10.9 255.255.255.252
 duplex auto
 speed auto
 media-type rj45
!
interface GigabitEthernet0/3
 no ip address
 shutdown
 duplex auto
 speed auto
 media-type rj45
!
router ospf 110
 network 203.0.113.1 0.0.0.0 area 0
 network 10.10.10.8 0.0.0.3 area 0
 network 192.0.2.0 0.0.0.7 area 0
 default-information originate always metric 10
!
router bgp 65000
 bgp log-neighbor-changes
 network 1.1.1.1 mask 255.255.255.255
 network 10.10.10.8 mask 255.255.255.252
 network 192.0.2.0 mask 255.255.255.248
 neighbor 203.0.113.2 remote-as 65000
 neighbor 203.0.113.2 update-source Loopback1
 neighbor 203.0.113.2 next-hop-self
 neighbor 200.0.113.254 remote-as 650002
 neighbor 200.0.113.254 fall-over bfd
 neighbor 200.0.113.254 route-map set_local_pref_AS65000 in
!
ip forward-protocol nd
!
!
no ip http server
no ip http secure-server
!
!
ip prefix-list INTERNET_IN seq 10 permit 0.0.0.0/0 le 32
ipv6 ioam timestamp
!
route-map set_local_pref_AS65000 permit 10
 match ip address prefix-list INTERNET_IN
 set local-preference 130
!
!
!
control-plane
!
banner exec ^C
