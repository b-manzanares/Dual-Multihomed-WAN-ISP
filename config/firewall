!
interface Loopback0
 ip address 203.0.113.20 255.255.255.255
!
interface Loopback2
 no ip address
!
interface GigabitEthernet0/0
 description *Link to VLAN 10*
 ip address 10.10.10.2 255.255.255.252
 ip nat inside
 ip virtual-reassembly in
 duplex auto
 speed auto
 media-type rj45
!
interface GigabitEthernet0/1
 description *Link to VLAN 20*
 ip address 10.10.10.6 255.255.255.252
 ip nat inside
 ip virtual-reassembly in
 duplex auto
 speed auto
 media-type rj45
!
interface GigabitEthernet0/2
 description *Link to Switch > Edge Routers*
 ip address 192.0.2.3 255.255.255.248
 ip nat outside
 ip virtual-reassembly in
 ip ospf bfd
 duplex auto
 speed auto
 media-type rj45
 bfd interval 300 min_rx 300 multiplier 3
!
interface GigabitEthernet0/3
 no ip address
 shutdown
 duplex auto
 speed auto
 media-type rj45
!
router ospf 110
 router-id 203.0.113.20
 network 203.0.113.20 0.0.0.0 area 0
 network 192.0.2.0 0.0.0.7 area 0
!
ip forward-protocol nd
!
!
no ip http server
no ip http secure-server
ip nat inside source list vlan_10 interface GigabitEthernet0/2 overload
ip nat inside source list vlan_20 interface GigabitEthernet0/2 overload
ip route 192.168.10.0 255.255.255.0 GigabitEthernet0/0
ip route 192.168.10.0 255.255.255.0 10.10.10.5 2
ip route 192.168.20.0 255.255.255.0 GigabitEthernet0/1
!
ip access-list standard vlan_10
 permit 192.168.10.0 0.0.0.255
ip access-list standard vlan_20
 permit 192.168.20.0 0.0.0.255
!
ipv6 ioam timestamp
!
!
!
control-plane
